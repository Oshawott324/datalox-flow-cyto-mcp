<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hand-crafted FlowJo 10 .wsp fixture for import parser unit tests.
  Tests that unsupported gate types emit warnings and are skipped,
  while their supported child gates are still imported correctly.

  Gate hierarchy:
    root
      EllipsoidGate "Ellipsoid" (skipped, should warn)
        PolygonGate "Child of Ellipsoid" (promoted to root parent)
      BooleanGate "Boolean" (skipped, should warn)
      PolygonGate "Supported Sibling" (imported normally)
-->
<Workspace version="20.0" creator="FlowJo-hand-crafted-fixture"
  xmlns:gating="http://www.isac-net.org/std/Gating-ML/v2.0/gating"
  xmlns:data-type="http://www.isac-net.org/std/Gating-ML/v2.0/datatypes"
  xmlns:transforms="http://www.isac-net.org/std/Gating-ML/v2.0/transformations">
  <SampleList>
    <Sample>
      <DataSet uri="file:///testdata/fixtures/flowjo/sample.fcs" keyword="$CYT"/>
      <SampleNode name="sample.fcs" owningGroup="" count="10000">
        <Subpopulations>
          <!-- EllipsoidGate: unsupported -- should emit warning, skip gate itself -->
          <Gate name="Ellipsoid" owningGroup="" count="5000"
            gating:id="gate-ellipse-001" gating:parent_id="">
            <gating:EllipsoidGate gating:id="gate-ellipse-001" gating:parent_id="">
              <gating:dimension gating:compensation-ref="uncompensated">
                <data-type:parameter data-type:name="FSC-A"/>
              </gating:dimension>
              <gating:dimension gating:compensation-ref="uncompensated">
                <data-type:parameter data-type:name="SSC-A"/>
              </gating:dimension>
            </gating:EllipsoidGate>
            <Subpopulations>
              <!-- Child of unsupported gate: should be promoted to root parent -->
              <Gate name="Child of Ellipsoid" owningGroup="" count="2000"
                gating:id="gate-child-002" gating:parent_id="gate-ellipse-001">
                <gating:PolygonGate gating:id="gate-child-002" gating:parent_id="gate-ellipse-001">
                  <gating:dimension gating:compensation-ref="uncompensated">
                    <data-type:parameter data-type:name="FSC-A"/>
                  </gating:dimension>
                  <gating:dimension gating:compensation-ref="uncompensated">
                    <data-type:parameter data-type:name="SSC-A"/>
                  </gating:dimension>
                  <gating:vertex>
                    <gating:coordinate data-type:value="60000"/>
                    <gating:coordinate data-type:value="30000"/>
                  </gating:vertex>
                  <gating:vertex>
                    <gating:coordinate data-type:value="120000"/>
                    <gating:coordinate data-type:value="30000"/>
                  </gating:vertex>
                  <gating:vertex>
                    <gating:coordinate data-type:value="90000"/>
                    <gating:coordinate data-type:value="70000"/>
                  </gating:vertex>
                </gating:PolygonGate>
              </Gate>
            </Subpopulations>
          </Gate>
          <!-- BooleanGate: unsupported -- should emit warning, no children -->
          <Gate name="Boolean" owningGroup="" count="3000"
            gating:id="gate-bool-003" gating:parent_id="">
            <gating:BooleanGate gating:id="gate-bool-003" gating:parent_id="">
              <gating:and>
                <gating:gateReference gating:ref="gate-child-002"/>
              </gating:and>
            </gating:BooleanGate>
          </Gate>
          <!-- PolygonGate: supported -- should import normally -->
          <Gate name="Supported Sibling" owningGroup="" count="4000"
            gating:id="gate-sibling-004" gating:parent_id="">
            <gating:PolygonGate gating:id="gate-sibling-004" gating:parent_id="">
              <gating:dimension gating:compensation-ref="uncompensated">
                <data-type:parameter data-type:name="FSC-A"/>
              </gating:dimension>
              <gating:dimension gating:compensation-ref="uncompensated">
                <data-type:parameter data-type:name="SSC-A"/>
              </gating:dimension>
              <gating:vertex>
                <gating:coordinate data-type:value="100000"/>
                <gating:coordinate data-type:value="40000"/>
              </gating:vertex>
              <gating:vertex>
                <gating:coordinate data-type:value="180000"/>
                <gating:coordinate data-type:value="40000"/>
              </gating:vertex>
              <gating:vertex>
                <gating:coordinate data-type:value="180000"/>
                <gating:coordinate data-type:value="90000"/>
              </gating:vertex>
            </gating:PolygonGate>
          </Gate>
        </Subpopulations>
      </SampleNode>
    </Sample>
  </SampleList>
</Workspace>
