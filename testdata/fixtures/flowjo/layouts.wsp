<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hand-crafted FlowJo 10 .wsp fixture for layout import tests. Covers:
   - a gating strategy layout (one sample, descending population paths)
   - a comparison layout (one population path, several samples)
   - a DataLayer naming a sampleID that has a SampleRef but no SampleNode
   - a Comp- prefixed axis declared by a spilloverMatrix prefix
   - a ChartData whose width/height are 0, with the real size on WindowPosition
   - a Multigraph grid, which is not modelled

  NOT validated by opening in FlowJo. See testdata/fixtures/flowjo/README.md.
-->
<Workspace version="20.0" creator="FlowJo-hand-crafted-fixture"
  xmlns:gating="http://www.isac-net.org/std/Gating-ML/v2.0/gating"
  xmlns:data-type="http://www.isac-net.org/std/Gating-ML/v2.0/datatypes"
  xmlns:transforms="http://www.isac-net.org/std/Gating-ML/v2.0/transformations">
  <Matrices>
    <transforms:spilloverMatrix prefix="Comp-" name="Acquisition-defined" suffix=""/>
  </Matrices>
  <Groups>
    <GroupNode name="All Samples">
      <Group name="All Samples">
        <SampleRefs>
          <SampleRef sampleID="1"/>
          <SampleRef sampleID="2"/>
          <SampleRef sampleID="99"/>
        </SampleRefs>
      </Group>
    </GroupNode>
  </Groups>
  <SampleList>
    <Sample>
      <DataSet uri="file:///alpha.fcs"/>
      <SampleNode name="alpha.fcs" sampleID="1" count="3">
        <Subpopulations>
          <Population name="Live" count="2">
            <Gate gating:id="live-alpha">
              <gating:RectangleGate gating:id="live-alpha">
                <gating:dimension gating:compensation-ref="uncompensated" gating:min="10" gating:max="900">
                  <data-type:parameter data-type:name="FSC-A"/>
                </gating:dimension>
                <gating:dimension gating:compensation-ref="uncompensated" gating:min="10" gating:max="900">
                  <data-type:parameter data-type:name="SSC-A"/>
                </gating:dimension>
              </gating:RectangleGate>
            </Gate>
          </Population>
        </Subpopulations>
      </SampleNode>
    </Sample>
    <Sample>
      <DataSet uri="file:///beta.fcs"/>
      <SampleNode name="beta.fcs" sampleID="2" count="3">
        <Subpopulations>
          <Population name="Live" count="2">
            <Gate gating:id="live-beta">
              <gating:RectangleGate gating:id="live-beta">
                <gating:dimension gating:compensation-ref="uncompensated" gating:min="10" gating:max="900">
                  <data-type:parameter data-type:name="FSC-A"/>
                </gating:dimension>
                <gating:dimension gating:compensation-ref="uncompensated" gating:min="10" gating:max="900">
                  <data-type:parameter data-type:name="SSC-A"/>
                </gating:dimension>
              </gating:RectangleGate>
            </Gate>
          </Population>
        </Subpopulations>
      </SampleNode>
    </Sample>
  </SampleList>
  <LayoutEditor>
    <Layout name="strategy" scale="0.33">
      <PrintLayout rows="1" columns="1" width="612" height="792"/>
      <Iteration iterationType="OFF" groupName="All Samples"/>
      <FigList>
        <ChartData x="10" y="10" width="256" height="256"
          showSampleName="1" showPopulationName="1" showCount="1" showFreq="0">
          <Graph type="Pseudocolor">
            <Axis dimension="x" name="FSC-A" auto="auto"/>
            <Axis dimension="y" name="SSC-A" auto="auto"/>
          </Graph>
          <Multigraph type="NONE" rows="0" columns="0"/>
          <PopModelList>
            <DataLayer path="" sampleID="1" sampleGMID="0">
              <LegendSpec color="#000000"/>
            </DataLayer>
          </PopModelList>
          <WindowPosition x="10" y="10" width="256" height="256" displayed="1"/>
        </ChartData>
        <!-- ChartData geometry is 0; the real size is only on WindowPosition. -->
        <ChartData x="300" y="10" width="0" height="0" showSampleName="1">
          <Graph type="Pseudocolor">
            <Axis dimension="x" name="Comp-FL03-A" auto="auto"/>
            <Axis dimension="y" name="SSC-A" auto="auto"/>
          </Graph>
          <PopModelList>
            <DataLayer path="Live" sampleID="1" sampleGMID="0"/>
          </PopModelList>
          <WindowPosition x="300" y="10" width="256" height="256" displayed="1"/>
        </ChartData>
      </FigList>
    </Layout>
    <Layout name="compare" scale="0.33">
      <PrintLayout rows="1" columns="1" width="612" height="792"/>
      <FigList>
        <ChartData x="10" y="400" width="256" height="256">
          <Graph type="DotPlot">
            <Axis dimension="x" name="FSC-A" auto="auto"/>
            <Axis dimension="y" name="SSC-A" auto="auto"/>
          </Graph>
          <PopModelList>
            <DataLayer path="Live" sampleID="1" sampleGMID="0"/>
          </PopModelList>
          <WindowPosition x="10" y="400" width="256" height="256" displayed="1"/>
        </ChartData>
        <ChartData x="300" y="400" width="256" height="256">
          <Graph type="DotPlot">
            <Axis dimension="x" name="FSC-A" auto="auto"/>
            <Axis dimension="y" name="SSC-A" auto="auto"/>
          </Graph>
          <PopModelList>
            <DataLayer path="Live" sampleID="2" sampleGMID="1"/>
          </PopModelList>
          <WindowPosition x="300" y="400" width="256" height="256" displayed="1"/>
        </ChartData>
        <!-- sampleID 99 has a SampleRef above but no SampleNode. -->
        <ChartData x="590" y="400" width="256" height="256">
          <Graph type="DotPlot">
            <Axis dimension="x" name="FSC-A" auto="auto"/>
            <Axis dimension="y" name="SSC-A" auto="auto"/>
          </Graph>
          <PopModelList>
            <DataLayer path="Live" sampleID="99" sampleGMID="2"/>
          </PopModelList>
          <WindowPosition x="590" y="400" width="256" height="256" displayed="1"/>
        </ChartData>
        <!-- Multigraph grid expansion is not modelled. -->
        <ChartData x="880" y="400" width="256" height="256">
          <Graph type="DotPlot">
            <Axis dimension="x" name="FSC-A" auto="auto"/>
            <Axis dimension="y" name="SSC-A" auto="auto"/>
          </Graph>
          <Multigraph type="GRID" rows="2" columns="3"/>
          <PopModelList>
            <DataLayer path="Live" sampleID="1" sampleGMID="0"/>
          </PopModelList>
          <WindowPosition x="880" y="400" width="256" height="256" displayed="1"/>
        </ChartData>
      </FigList>
    </Layout>
  </LayoutEditor>
</Workspace>
