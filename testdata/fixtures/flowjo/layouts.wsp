<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hand-crafted FlowJo 10 .wsp fixture for layout import tests. Covers:
   - a gating strategy layout (one sample, descending population paths)
   - a comparison layout (one population path, several samples)
   - a DataLayer naming a sampleID that has a SampleRef but no SampleNode
   - a Comp- prefixed axis declared by a spilloverMatrix prefix
   - a ChartData whose width/height are 0, with the real size on WindowPosition
   - a Multigraph grid, which is not modelled

  Deliberately conflicting definitions across samples:
   - alpha and beta both carry a matrix with transforms:id="shared-matrix-id",
     as FlowJo does, but with DIFFERENT coefficients. Keying only on the FlowJo
     id collapses them and compensates every panel with one sample's matrix.
   - alpha and beta define DIFFERENT biex parameters for Comp-FL03-A, so a
     workspace-wide transform map returns the wrong parameters for one of them.
   - Comp-SSC-A names a real prefix but a channel the matrix does not carry.
   - FL13-A has no transform in alpha at all.

  NOT validated by opening in FlowJo. See testdata/fixtures/flowjo/README.md.
-->
<Workspace version="20.0" creator="FlowJo-hand-crafted-fixture"
  xmlns:gating="http://www.isac-net.org/std/Gating-ML/v2.0/gating"
  xmlns:data-type="http://www.isac-net.org/std/Gating-ML/v2.0/datatypes"
  xmlns:transforms="http://www.isac-net.org/std/Gating-ML/v2.0/transformations">
  <!--
    A global matrix, declaring its own prefix and deliberately reusing the same
    transforms:id as the per-sample matrices. A panel axis naming "Acq-" must not
    bind a per-sample matrix just because the ids match; global-matrix import is
    out of scope, so such an axis has to report rather than render.
  -->
  <Matrices>
    <transforms:spilloverMatrix prefix="Acq-" name="Acquisition-defined" suffix=""
      transforms:id="shared-matrix-id">
      <data-type:parameters>
        <data-type:parameter data-type:name="FL03-A"/>
        <data-type:parameter data-type:name="FL13-A"/>
      </data-type:parameters>
      <transforms:spillover data-type:parameter="FL03-A">
        <transforms:coefficient data-type:parameter="FL03-A" transforms:value="1"/>
        <transforms:coefficient data-type:parameter="FL13-A" transforms:value="0.99"/>
      </transforms:spillover>
      <transforms:spillover data-type:parameter="FL13-A">
        <transforms:coefficient data-type:parameter="FL03-A" transforms:value="0.99"/>
        <transforms:coefficient data-type:parameter="FL13-A" transforms:value="1"/>
      </transforms:spillover>
    </transforms:spilloverMatrix>
  </Matrices>
  <Groups>
    <GroupNode name="All Samples">
      <Group name="All Samples">
        <SampleRefs>
          <SampleRef sampleID="1"/>
          <SampleRef sampleID="2"/>
          <SampleRef sampleID="99"/>
        </SampleRefs>
      </Group>
    </GroupNode>
  </Groups>
  <SampleList>
    <Sample>
      <DataSet uri="file:///alpha.fcs"/>
      <Transformations>
        <transforms:linear transforms:minRange="0" transforms:maxRange="262144" gain="1">
          <data-type:parameter data-type:name="FSC-A"/>
        </transforms:linear>
        <transforms:linear transforms:minRange="0" transforms:maxRange="262144" gain="1">
          <data-type:parameter data-type:name="SSC-A"/>
        </transforms:linear>
        <transforms:biex transforms:length="256" transforms:maxRange="262144"
          transforms:neg="0" transforms:width="-10" transforms:pos="4.3">
          <data-type:parameter data-type:name="Comp-FL03-A"/>
        </transforms:biex>
        <transforms:biex transforms:length="256" transforms:maxRange="262144"
          transforms:neg="0" transforms:width="-10" transforms:pos="4.3">
          <data-type:parameter data-type:name="Comp-SSC-A"/>
        </transforms:biex>
        <!-- No transform for FL13-A, so a panel using it cannot state a scale. -->
      </Transformations>
      <transforms:spilloverMatrix prefix="Comp-" name="Compensation" suffix=""
        transforms:id="shared-matrix-id">
        <data-type:parameters>
          <data-type:parameter data-type:name="FL03-A"/>
          <data-type:parameter data-type:name="FL13-A"/>
        </data-type:parameters>
        <transforms:spillover data-type:parameter="FL03-A">
          <transforms:coefficient data-type:parameter="FL03-A" transforms:value="1"/>
          <transforms:coefficient data-type:parameter="FL13-A" transforms:value="0.1"/>
        </transforms:spillover>
        <transforms:spillover data-type:parameter="FL13-A">
          <transforms:coefficient data-type:parameter="FL03-A" transforms:value="0.02"/>
          <transforms:coefficient data-type:parameter="FL13-A" transforms:value="1"/>
        </transforms:spillover>
      </transforms:spilloverMatrix>
      <SampleNode name="alpha.fcs" sampleID="1" count="3">
        <Subpopulations>
          <Population name="Live" count="2">
            <Gate gating:id="live-alpha">
              <gating:RectangleGate gating:id="live-alpha">
                <gating:dimension gating:min="10" gating:max="900">
                  <data-type:parameter data-type:name="FSC-A"/>
                </gating:dimension>
                <gating:dimension gating:min="10" gating:max="900">
                  <data-type:parameter data-type:name="SSC-A"/>
                </gating:dimension>
              </gating:RectangleGate>
            </Gate>
          </Population>
        </Subpopulations>
      </SampleNode>
    </Sample>
    <Sample>
      <DataSet uri="file:///beta.fcs"/>
      <Transformations>
        <transforms:linear transforms:minRange="0" transforms:maxRange="262144" gain="1">
          <data-type:parameter data-type:name="FSC-A"/>
        </transforms:linear>
        <transforms:linear transforms:minRange="0" transforms:maxRange="262144" gain="1">
          <data-type:parameter data-type:name="SSC-A"/>
        </transforms:linear>
        <!-- Same parameter, different biex parameters from alpha. -->
        <transforms:biex transforms:length="256" transforms:maxRange="262144"
          transforms:neg="0" transforms:width="-5" transforms:pos="4.9">
          <data-type:parameter data-type:name="Comp-FL03-A"/>
        </transforms:biex>
      </Transformations>
      <!-- Same transforms:id as alpha, different coefficients. -->
      <transforms:spilloverMatrix prefix="Comp-" name="Compensation" suffix=""
        transforms:id="shared-matrix-id">
        <data-type:parameters>
          <data-type:parameter data-type:name="FL03-A"/>
          <data-type:parameter data-type:name="FL13-A"/>
        </data-type:parameters>
        <transforms:spillover data-type:parameter="FL03-A">
          <transforms:coefficient data-type:parameter="FL03-A" transforms:value="1"/>
          <transforms:coefficient data-type:parameter="FL13-A" transforms:value="0.5"/>
        </transforms:spillover>
        <transforms:spillover data-type:parameter="FL13-A">
          <transforms:coefficient data-type:parameter="FL03-A" transforms:value="0.07"/>
          <transforms:coefficient data-type:parameter="FL13-A" transforms:value="1"/>
        </transforms:spillover>
      </transforms:spilloverMatrix>
      <SampleNode name="beta.fcs" sampleID="2" count="3">
        <Subpopulations>
          <Population name="Live" count="2">
            <Gate gating:id="live-beta">
              <gating:RectangleGate gating:id="live-beta">
                <gating:dimension gating:min="10" gating:max="900">
                  <data-type:parameter data-type:name="FSC-A"/>
                </gating:dimension>
                <gating:dimension gating:min="10" gating:max="900">
                  <data-type:parameter data-type:name="SSC-A"/>
                </gating:dimension>
              </gating:RectangleGate>
            </Gate>
          </Population>
        </Subpopulations>
      </SampleNode>
    </Sample>
  </SampleList>
  <LayoutEditor>
    <Layout name="strategy" scale="0.33">
      <PrintLayout rows="1" columns="1" width="612" height="792"/>
      <Iteration iterationType="OFF" groupName="All Samples"/>
      <FigList>
        <ChartData x="10" y="10" width="256" height="256"
          showSampleName="1" showPopulationName="1" showCount="1" showFreq="0">
          <Graph type="Pseudocolor">
            <Axis dimension="x" name="FSC-A" auto="auto"/>
            <Axis dimension="y" name="SSC-A" auto="auto"/>
          </Graph>
          <Multigraph type="NONE" rows="0" columns="0"/>
          <PopModelList>
            <DataLayer path="" sampleID="1" sampleGMID="0">
              <LegendSpec color="#000000"/>
            </DataLayer>
          </PopModelList>
          <WindowPosition x="10" y="10" width="256" height="256" displayed="1"/>
        </ChartData>
        <!-- ChartData geometry is 0; the real size is only on WindowPosition. -->
        <ChartData x="300" y="10" width="0" height="0" showSampleName="1">
          <Graph type="Pseudocolor">
            <Axis dimension="x" name="Comp-FL03-A" auto="auto"/>
            <Axis dimension="y" name="SSC-A" auto="auto"/>
          </Graph>
          <PopModelList>
            <DataLayer path="Live" sampleID="1" sampleGMID="0"/>
          </PopModelList>
          <WindowPosition x="300" y="10" width="256" height="256" displayed="1"/>
        </ChartData>
      </FigList>
    </Layout>
    <Layout name="compare" scale="0.33">
      <PrintLayout rows="1" columns="1" width="612" height="792"/>
      <FigList>
        <ChartData x="10" y="400" width="256" height="256">
          <Graph type="DotPlot">
            <Axis dimension="x" name="Comp-FL03-A" auto="auto"/>
            <Axis dimension="y" name="SSC-A" auto="auto"/>
          </Graph>
          <PopModelList>
            <DataLayer path="Live" sampleID="1" sampleGMID="0"/>
          </PopModelList>
          <WindowPosition x="10" y="400" width="256" height="256" displayed="1"/>
        </ChartData>
        <ChartData x="300" y="400" width="256" height="256">
          <Graph type="DotPlot">
            <Axis dimension="x" name="Comp-FL03-A" auto="auto"/>
            <Axis dimension="y" name="SSC-A" auto="auto"/>
          </Graph>
          <PopModelList>
            <DataLayer path="Live" sampleID="2" sampleGMID="1"/>
          </PopModelList>
          <WindowPosition x="300" y="400" width="256" height="256" displayed="1"/>
        </ChartData>
        <!-- sampleID 99 has a SampleRef above but no SampleNode. -->
        <ChartData x="590" y="400" width="256" height="256">
          <Graph type="DotPlot">
            <Axis dimension="x" name="FSC-A" auto="auto"/>
            <Axis dimension="y" name="SSC-A" auto="auto"/>
          </Graph>
          <PopModelList>
            <DataLayer path="Live" sampleID="99" sampleGMID="2"/>
          </PopModelList>
          <WindowPosition x="590" y="400" width="256" height="256" displayed="1"/>
        </ChartData>
        <!-- Multigraph grid expansion is not modelled. -->
        <ChartData x="880" y="400" width="256" height="256">
          <Graph type="DotPlot">
            <Axis dimension="x" name="FSC-A" auto="auto"/>
            <Axis dimension="y" name="SSC-A" auto="auto"/>
          </Graph>
          <Multigraph type="GRID" rows="2" columns="3"/>
          <PopModelList>
            <DataLayer path="Live" sampleID="1" sampleGMID="0"/>
          </PopModelList>
          <WindowPosition x="880" y="400" width="256" height="256" displayed="1"/>
        </ChartData>
        <!-- Comp- prefix on a channel the matrix does not carry. -->
        <ChartData x="10" y="700" width="256" height="256">
          <Graph type="DotPlot">
            <Axis dimension="x" name="Comp-SSC-A" auto="auto"/>
            <Axis dimension="y" name="FSC-A" auto="auto"/>
          </Graph>
          <PopModelList>
            <DataLayer path="Live" sampleID="1" sampleGMID="0"/>
          </PopModelList>
          <WindowPosition x="10" y="700" width="256" height="256" displayed="1"/>
        </ChartData>
        <!-- alpha defines no transform for FL13-A. -->
        <ChartData x="300" y="700" width="256" height="256">
          <Graph type="DotPlot">
            <Axis dimension="x" name="FL13-A" auto="auto"/>
            <Axis dimension="y" name="FSC-A" auto="auto"/>
          </Graph>
          <PopModelList>
            <DataLayer path="Live" sampleID="1" sampleGMID="0"/>
          </PopModelList>
          <WindowPosition x="300" y="700" width="256" height="256" displayed="1"/>
        </ChartData>
        <!-- References the global matrix's prefix, which no sample defines. -->
        <ChartData x="590" y="700" width="256" height="256">
          <Graph type="DotPlot">
            <Axis dimension="x" name="Acq-FL03-A" auto="auto"/>
            <Axis dimension="y" name="SSC-A" auto="auto"/>
          </Graph>
          <PopModelList>
            <DataLayer path="Live" sampleID="1" sampleGMID="0"/>
          </PopModelList>
          <WindowPosition x="590" y="700" width="256" height="256" displayed="1"/>
        </ChartData>
      </FigList>
    </Layout>
  </LayoutEditor>
</Workspace>
